# 只作变量名模板，不要把真实值提交到 Git。
SPRING_PROFILES_ACTIVE=prod
PORT=8080

AGENT_WORK_FOOT_DB_URL=jdbc:mysql://mysql.internal:3306/agent_work_foot?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&sslMode=VERIFY_IDENTITY
AGENT_WORK_FOOT_DB_USERNAME=agent_app
AGENT_WORK_FOOT_DB_PASSWORD=replace-in-cloud-secret-manager
AGENT_WORK_FOOT_DB_POOL_MAX_SIZE=20
AGENT_WORK_FOOT_DB_POOL_MIN_IDLE=5

AGENT_WORK_FOOT_REDIS_HOST=redis.internal
AGENT_WORK_FOOT_REDIS_PORT=6379
AGENT_WORK_FOOT_REDIS_USERNAME=default
AGENT_WORK_FOOT_REDIS_PASSWORD=replace-in-cloud-secret-manager
AGENT_WORK_FOOT_REDIS_SSL=true
AGENT_WORK_FOOT_REDIS_CONNECT_TIMEOUT=PT1S
AGENT_WORK_FOOT_REDIS_COMMAND_TIMEOUT=PT1S

AGENT_WORK_FOOT_JWT_ACTIVE_KEY_ID=current
AGENT_WORK_FOOT_JWT_ACTIVE_SECRET=replace-with-at-least-32-random-bytes
AGENT_WORK_FOOT_JWT_PREVIOUS_KEY_ID=
AGENT_WORK_FOOT_JWT_PREVIOUS_SECRET=

WECHAT_MINI_PROGRAM_APP_ID=replace-in-cloud-secret-manager
WECHAT_MINI_PROGRAM_APP_SECRET=replace-in-cloud-secret-manager
# 仅微信云托管环境使用；需在控制台开启“云调用 - 开放接口服务”并允许 /sns/jscode2session。
WECHAT_MINI_PROGRAM_CODE2_SESSION_URL=http://api.weixin.qq.com/sns/jscode2session
AGENT_WORK_FOOT_ADMIN_ORIGIN=https://admin.example.com
