# Redis 连接变量为后续缓存准备；当前不启用 Redis 限流。
AGENT_WORK_FOOT_REDIS_HOST=redis.internal
AGENT_WORK_FOOT_REDIS_PORT=6379
AGENT_WORK_FOOT_REDIS_USERNAME=default
AGENT_WORK_FOOT_REDIS_PASSWORD=replace-in-cloud-secret-manager
AGENT_WORK_FOOT_REDIS_SSL=true
AGENT_WORK_FOOT_REDIS_CONNECT_TIMEOUT=PT1S
AGENT_WORK_FOOT_REDIS_COMMAND_TIMEOUT=PT1S
